<Window x:Class="UsageBar.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UsageBar"
        Title="Usage Bar" Width="360" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Left="-10000" Top="-10000"
        Background="Transparent" FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0" UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
        <local:NullToCollapsed x:Key="NotNull"/>

        <!-- The coloured tag square. -->
        <DataTemplate x:Key="Badge">
            <Border Width="20" Height="20" CornerRadius="5" Background="{Binding Badge}">
                <TextBlock Text="{Binding Tag}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </DataTemplate>

        <!-- An issue line with Connect when the Claude app source waits for permission. -->
        <DataTemplate x:Key="Issue">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Connect…" Style="{StaticResource WinButton}" Height="26" Padding="10,0" FontSize="12" Margin="8,0,0,0"
                        Visibility="{Binding CanConnect, Converter={StaticResource Vis}}" Click="Connect_Click"
                        ToolTip="Let Usage Bar read the Claude app's existing sign-in (read-only)."/>
                <TextBlock Text="{Binding Message}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource OverPace}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </DataTemplate>

        <!-- Layout A: one limit row. -->
        <DataTemplate x:Key="LimitCompact">
            <StackPanel Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" FontSize="12" Typography.NumeralAlignment="Tabular">
                        <Run Text="{Binding PercentText, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{Binding CompactTrailing, Mode=OneWay}" Foreground="{DynamicResource Secondary}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"/>
                </DockPanel>
                <local:PaceBar Margin="0,6,0,6" Fraction="{Binding Fraction}" Tick="{Binding Tick}" BarBrush="{Binding Color}" BarHeight="6" TickHeight="12"/>
                <TextBlock x:Name="Pace" Text="{Binding PaceLine}" FontSize="12" Foreground="{DynamicResource Secondary}"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOver}" Value="True">
                    <Setter TargetName="Pace" Property="Foreground" Value="{DynamicResource OverPace}"/>
                    <Setter TargetName="Pace" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Layout B: one limit row, larger. -->
        <DataTemplate x:Key="LimitLarge">
            <StackPanel Margin="0,0,0,16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding LargeTrailing}" FontSize="12" Foreground="{DynamicResource Secondary}" VerticalAlignment="Bottom"
                               Typography.NumeralAlignment="Tabular"/>
                    <TextBlock Text="{Binding LargeTitle}" FontSize="15" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
                </DockPanel>
                <local:PaceBar Margin="0,6,0,6" Fraction="{Binding Fraction}" Tick="{Binding Tick}" BarBrush="{Binding Color}" BarHeight="7" TickHeight="13"/>
                <TextBlock x:Name="Pace" Text="{Binding PaceLine}" FontSize="12" Foreground="{DynamicResource Secondary}"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOver}" Value="True">
                    <Setter TargetName="Pace" Property="Foreground" Value="{DynamicResource OverPace}"/>
                    <Setter TargetName="Pace" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Layout A: one account section, preceded by a separator. -->
        <DataTemplate x:Key="AccountA">
            <StackPanel>
                <Border Height="1" Background="{DynamicResource Separator}" Margin="0,0,0,12"/>
                <DockPanel Margin="0,0,0,12">
                    <ContentPresenter DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource Badge}" VerticalAlignment="Top"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CostLine}" Margin="8,2,0,0" FontSize="12" Foreground="{DynamicResource Secondary}" VerticalAlignment="Top"
                               Typography.NumeralAlignment="Tabular" Visibility="{Binding CostLine, Converter={StaticResource NotNull}}"/>
                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <!-- Each account's own age: sign-ins poll at different rates (decision 19). -->
                        <TextBlock Text="{Binding UpdatedText}" FontSize="11" Foreground="{DynamicResource Secondary}"/>
                        <TextBlock Text="{Binding HeaderNote}" FontSize="11" Foreground="{DynamicResource Secondary}" TextWrapping="Wrap" Visibility="{Binding HeaderNote, Converter={StaticResource NotNull}}"/>
                    </StackPanel>
                </DockPanel>
                <Border Margin="0,0,0,12" Visibility="{Binding Issue, Converter={StaticResource NotNull}}"><ContentPresenter Content="{Binding Issue}" ContentTemplate="{StaticResource Issue}"/></Border>
                <StackPanel Opacity="{Binding ValuesOpacity}">
                    <ItemsControl ItemsSource="{Binding Limits}" ItemTemplate="{StaticResource LimitCompact}" Focusable="False"/>
                    <TextBlock Text="{Binding NoLimits}" Style="{StaticResource SecondaryText}" Margin="0,0,0,12" Visibility="{Binding NoLimits, Converter={StaticResource NotNull}}"/>
                    <TextBlock Text="{Binding ExtraUsage}" Style="{StaticResource SecondaryText}" Margin="0,0,0,12" Visibility="{Binding ExtraUsage, Converter={StaticResource NotNull}}"/>
                </StackPanel>
                <TextBlock Text="{Binding Loading}" Style="{StaticResource SecondaryText}" Margin="0,0,0,12" Visibility="{Binding Loading, Converter={StaticResource NotNull}}"/>
                <TextBlock Text="{Binding ThirtyDays}" Style="{StaticResource SecondaryText}" Margin="0,0,0,12" Typography.NumeralAlignment="Tabular"
                           Visibility="{Binding ThirtyDays, Converter={StaticResource NotNull}}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Layout B: an account tab in the segmented control. -->
        <DataTemplate x:Key="Tab">
            <Button Click="Tab_Click" Tag="{Binding Id}" FocusVisualStyle="{x:Null}" Cursor="Arrow" ToolTip="{Binding Name}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" MinHeight="30" Background="Transparent">
                            <DockPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0">
                                <Border DockPanel.Dock="Left" Width="17" Height="17" CornerRadius="4" Background="{Binding Badge}">
                                    <TextBlock Text="{Binding Tag}" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Name}" Margin="7,0,0,0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Text}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding DataContext.ShowTabNames, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Selected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SegmentSelected}"/>
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value><DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.25" Direction="270"/></Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Root" Background="{DynamicResource FlyoutFill}">
        <DockPanel>
            <!-- The menu rows, as at the bottom of the Mac dropdown; pinned below the scrolling accounts. -->
            <StackPanel DockPanel.Dock="Bottom" x:Name="MenuRows">
            <Border Height="1" Background="{DynamicResource Separator}" Margin="16,0"/>
            <StackPanel Margin="6,4">
                <Button Style="{StaticResource MenuRow}" Click="Refresh_Click">
                    <DockPanel>
                        <Path Data="{StaticResource IconRefresh}" Style="{StaticResource IconPath}" DockPanel.Dock="Left"/>
                        <TextBlock DockPanel.Dock="Right" Text="Ctrl+R" FontSize="12" Foreground="{DynamicResource Secondary}" VerticalAlignment="Center"/>
                        <TextBlock Text="Refresh Now" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>
                <Button Style="{StaticResource MenuRow}" Click="About_Click">
                    <DockPanel>
                        <Path Data="{StaticResource IconInfo}" Style="{StaticResource IconPath}" DockPanel.Dock="Left"/>
                        <TextBlock Text="About Usage Bar" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>
                <Button Style="{StaticResource MenuRow}" Click="Settings_Click">
                    <DockPanel>
                        <Path Data="{StaticResource IconGear}" Style="{StaticResource IconPath}" DockPanel.Dock="Left"/>
                        <TextBlock DockPanel.Dock="Right" Text="Ctrl+," FontSize="12" Foreground="{DynamicResource Secondary}" VerticalAlignment="Center"/>
                        <TextBlock Text="Settings…" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>
            </StackPanel>
            <Border Height="1" Background="{DynamicResource Separator}" Margin="16,0"/>
            <StackPanel Margin="6,4,6,6">
                <Button Style="{StaticResource MenuRow}" Click="Quit_Click">
                    <DockPanel>
                        <Path Data="{StaticResource IconPower}" Style="{StaticResource IconPath}" DockPanel.Dock="Left"/>
                        <TextBlock DockPanel.Dock="Right" Text="Ctrl+Q" FontSize="12" Foreground="{DynamicResource Secondary}" VerticalAlignment="Center"/>
                        <TextBlock Text="Quit Usage Bar" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>
            </StackPanel>
            </StackPanel>
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
            <!-- No accounts, either layout. -->
            <StackPanel x:Name="EmptyState" Margin="16,14,16,12" Visibility="Collapsed">
                <TextBlock Text="Claude" FontSize="17" FontWeight="SemiBold"/>
                <Border Height="1" Background="{DynamicResource Separator}" Margin="0,12"/>
                <StackPanel Margin="0,4">
                    <TextBlock Text="No accounts" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="No Claude sign-in was found on this PC. Add the Claude Code login or the Claude app in Settings."
                               Style="{StaticResource SecondaryText}" TextAlignment="Center" Margin="0,6,0,0"/>
                    <Button Content="Open Settings…" Style="{StaticResource WinButton}" HorizontalAlignment="Center" Margin="0,12,0,0"
                            Click="OpenAccounts_Click"/>
                </StackPanel>
            </StackPanel>

            <!-- Layout A: all accounts. -->
            <StackPanel x:Name="LayoutA" Margin="16,14,16,0">
                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="Refresh_Click" ToolTip="Refresh now" VerticalAlignment="Top">
                        <Path Data="{StaticResource IconRefresh}" Style="{StaticResource IconPath}" StrokeThickness="1.5"/>
                    </Button>
                    <TextBlock Text="Claude" FontSize="17" FontWeight="SemiBold"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Accounts}" ItemTemplate="{StaticResource AccountA}" Focusable="False"/>
            </StackPanel>

            <!-- Layout B: one account at a time. -->
            <StackPanel x:Name="LayoutB" Margin="16,12,16,0" DataContext="{Binding Selected}">
                <Border CornerRadius="9" Background="{DynamicResource SegmentFill}" Padding="2" Margin="0,0,0,14"
                        Visibility="{Binding DataContext.ShowTabs, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}">
                    <ItemsControl ItemsSource="{Binding DataContext.Accounts, RelativeSource={RelativeSource AncestorType=Window}}" ItemTemplate="{StaticResource Tab}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>
                <DockPanel Margin="0,0,0,14">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="Refresh_Click" ToolTip="Refresh now" VerticalAlignment="Top">
                        <Path Data="{StaticResource IconRefresh}" Style="{StaticResource IconPath}" StrokeThickness="1.5"/>
                    </Button>
                    <StackPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,8,0"><Run Text="Claude · "/><Run Text="{Binding Name, Mode=OneWay}"/></TextBlock>
                        <TextBlock Text="{Binding UpdatedText}" FontSize="12" Foreground="{DynamicResource Secondary}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding HeaderNote}" FontSize="11" Foreground="{DynamicResource Secondary}" TextWrapping="Wrap" Visibility="{Binding HeaderNote, Converter={StaticResource NotNull}}"/>
                    </StackPanel>
                </DockPanel>
                <Border Height="1" Background="{DynamicResource Separator}" Margin="0,0,0,14"/>
                <Border Margin="0,0,0,14" Visibility="{Binding Issue, Converter={StaticResource NotNull}}"><ContentPresenter Content="{Binding Issue}" ContentTemplate="{StaticResource Issue}"/></Border>
                <StackPanel Opacity="{Binding ValuesOpacity}">
                    <ItemsControl ItemsSource="{Binding Limits}" ItemTemplate="{StaticResource LimitLarge}" Focusable="False"/>
                    <TextBlock Text="{Binding ExtraUsage}" Style="{StaticResource SecondaryText}" Margin="0,0,0,14" Visibility="{Binding ExtraUsage, Converter={StaticResource NotNull}}"/>
                </StackPanel>
                <TextBlock Text="{Binding Loading}" Style="{StaticResource SecondaryText}" Margin="0,0,0,14" Visibility="{Binding Loading, Converter={StaticResource NotNull}}"/>
                <StackPanel Visibility="{Binding Counting, Converter={StaticResource Vis}}">
                    <Border Height="1" Background="{DynamicResource Separator}" Margin="0,0,0,14"/>
                    <TextBlock Text="Counting…" Style="{StaticResource SecondaryText}" Margin="0,0,0,14"/>
                </StackPanel>
                <StackPanel DataContext="{Binding Cost}" Visibility="{Binding Converter={StaticResource NotNull}}">
                    <Border Height="1" Background="{DynamicResource Separator}" Margin="0,0,0,14"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="Today" Style="{StaticResource SecondaryText}"/>
                            <TextBlock Text="{Binding Today}" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0" Typography.NumeralAlignment="Tabular"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Grid.Row="0" Margin="6,0,0,12">
                            <TextBlock Text="30 days" Style="{StaticResource SecondaryText}"/>
                            <TextBlock Text="{Binding ThirtyDays}" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0" Typography.NumeralAlignment="Tabular"/>
                        </StackPanel>
                        <StackPanel Grid.Column="0" Grid.Row="1">
                            <TextBlock Text="Today tokens" Style="{StaticResource SecondaryText}"/>
                            <TextBlock Text="{Binding TodayTokens}" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0" Typography.NumeralAlignment="Tabular"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Grid.Row="1" Margin="6,0,0,0">
                            <TextBlock Text="30-day tokens" Style="{StaticResource SecondaryText}"/>
                            <TextBlock Text="{Binding ThirtyDayTokens}" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0" Typography.NumeralAlignment="Tabular"/>
                        </StackPanel>
                    </Grid>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding MaxText}" Style="{StaticResource SecondaryText}" Typography.NumeralAlignment="Tabular"/>
                        <TextBlock Text="Cost per day, last 30 days" Style="{StaticResource SecondaryText}"/>
                    </DockPanel>
                    <local:CostChart Bars="{Binding Bars}" BarBrush="{Binding BarBrush}" Margin="0,0,0,14"/>
                    <TextBlock Text="{Binding TopModel}" FontSize="12" Visibility="{Binding TopModel, Converter={StaticResource NotNull}}"/>
                    <TextBlock Text="{Binding Footnote}" Style="{StaticResource SecondaryText}" Margin="0,2,0,14"/>
                </StackPanel>
            </StackPanel>

            </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
