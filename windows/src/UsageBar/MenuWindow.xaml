<Window x:Class="UsageBar.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Usage Bar menu" Width="220" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Left="-10000" Top="-10000"
        Background="Transparent" FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Text}" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0" UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Border x:Name="Root" Background="{DynamicResource FlyoutFill}" Padding="4">
        <StackPanel>
            <Button Style="{StaticResource MenuRow}" Height="32" Click="Refresh_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconRefresh}" Style="{StaticResource IconPath}"/>
                    <TextBlock Text="Refresh Now" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource MenuRow}" Height="32" Click="Settings_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconGear}" Style="{StaticResource IconPath}"/>
                    <TextBlock Text="Settings…" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource MenuRow}" Height="32" Click="About_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconInfo}" Style="{StaticResource IconPath}"/>
                    <TextBlock Text="About Usage Bar" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Border Height="1" Background="{DynamicResource Separator}" Margin="0,4"/>
            <Button Style="{StaticResource MenuRow}" Height="32" Click="Quit_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconPower}" Style="{StaticResource IconPath}"/>
                    <TextBlock Text="Quit Usage Bar" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
