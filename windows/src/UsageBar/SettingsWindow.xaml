<Window x:Class="UsageBar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UsageBar"
        Title="Usage Bar Settings" Width="562" SizeToContent="Height" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowFill}" FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Text}" UseLayoutRounding="True">
    <Window.Resources>
        <local:NullToCollapsed x:Key="NotNull"/>
        <BooleanToVisibilityConverter x:Key="Vis"/>

        <DataTemplate x:Key="AccountCard">
            <StackPanel Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal" Margin="10,0,0,8">
                    <Border Width="18" Height="18" CornerRadius="4" Background="{Binding Badge}">
                        <TextBlock Text="{Binding Tag}" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding Name}" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Name" Style="{StaticResource RowLabel}"/>
                            <TextBox DockPanel.Dock="Right" Width="220" Style="{StaticResource WinTextBox}" VerticalAlignment="Center"
                                     Text="{Binding Name, UpdateSourceTrigger=LostFocus}" MaxLength="30" AutomationProperties.Name="Name"/>
                        </DockPanel>
                        <Border Style="{StaticResource RowSeparator}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Tag" Style="{StaticResource RowLabel}"/>
                            <TextBox DockPanel.Dock="Right" Width="46" Style="{StaticResource WinTextBox}" VerticalAlignment="Center" TextAlignment="Center"
                                     Padding="2,0" Text="{Binding Tag, UpdateSourceTrigger=LostFocus}" MaxLength="2" AutomationProperties.Name="Tag"/>
                        </DockPanel>
                        <Border Style="{StaticResource RowSeparator}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Colour" Style="{StaticResource RowLabel}"/>
                            <Grid DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource WinButton}" Width="56" Padding="0" Click="Colour_Click" ToolTip="Choose a colour" AutomationProperties.Name="Colour">
                                    <Border Width="40" Height="20" CornerRadius="10" Background="{Binding Color}"/>
                                </Button>
                                <Popup Placement="Bottom" StaysOpen="False" AllowsTransparency="True" IsOpen="{Binding PaletteOpen, Mode=TwoWay}">
                                    <Border Margin="8" Padding="8" CornerRadius="8" Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1">
                                        <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.3"/></Border.Effect>
                                        <ItemsControl ItemsSource="{Binding Palette}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Click="Swatch_Click" Tag="{Binding Hex}" Margin="3" Width="34" Height="22" ToolTip="{Binding Hex}" FocusVisualStyle="{x:Null}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bd" CornerRadius="11" Background="{Binding Brush}" BorderThickness="2" BorderBrush="Transparent"/>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Text}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Popup>
                            </Grid>
                        </DockPanel>
                        <Border Style="{StaticResource RowSeparator}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Sign-in source" Style="{StaticResource RowLabel}"/>
                            <ComboBox DockPanel.Dock="Right" MinWidth="170" Style="{StaticResource WinCombo}" VerticalAlignment="Center"
                                      ItemsSource="{Binding SourceOptions}" SelectedIndex="{Binding SourceIndex}" AutomationProperties.Name="Sign-in source"/>
                        </DockPanel>
                        <Border Style="{StaticResource RowSeparator}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Status" Style="{StaticResource RowLabel}"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="16" Height="16" Margin="0,0,8,0" Visibility="{Binding StatusOk, Converter={StaticResource Vis}}">
                                    <Ellipse Fill="{DynamicResource Success}"/>
                                    <Path Data="M4.8,8.2 L6.9,10.3 L11.2,5.7" Stroke="{DynamicResource CardFill}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Grid>
                                <TextBlock x:Name="StatusText" Text="{Binding Status}" FontSize="13" Foreground="{DynamicResource Secondary}" MaxWidth="330" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" ToolTip="{Binding Status}"/>
                                <Button Content="Connect…" Style="{StaticResource WinButton}" Height="28" Margin="10,0,0,0" Click="Connect_Click"
                                        Visibility="{Binding CanConnect, Converter={StaticResource Vis}}"
                                        ToolTip="Let Usage Bar read the Claude app's existing sign-in (read-only)."/>
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource RowSeparator}"/>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Show in tray" Style="{StaticResource RowLabel}"/>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" IsChecked="{Binding ShowInTray}" AutomationProperties.Name="Show in tray"/>
                        </DockPanel>
                        <Border Style="{StaticResource RowSeparator}"/>
                        <DockPanel Style="{StaticResource Row}" MinHeight="52">
                            <Button DockPanel.Dock="Right" Content="Remove Account…" Style="{StaticResource WinButton}" VerticalAlignment="Center" Click="Remove_Click"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Tabs, as on the Mac: icon over label, centred. -->
        <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,10">
                <RadioButton x:Name="TabGeneral" Style="{StaticResource TabButton}" GroupName="tabs" Checked="Tab_Checked" Margin="2,0">
                    <StackPanel>
                        <Path Data="{StaticResource IconGear}" Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                              StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5" Margin="0,4,0,7">
                            <Path.RenderTransform><ScaleTransform ScaleX="1.5" ScaleY="1.5"/></Path.RenderTransform>
                        </Path>
                        <TextBlock Text="General" HorizontalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabAccounts" Style="{StaticResource TabButton}" GroupName="tabs" Checked="Tab_Checked" Margin="2,0">
                    <StackPanel>
                        <Path Data="{StaticResource IconPeople}" Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                              StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5" Margin="0,4,0,7">
                            <Path.RenderTransform><ScaleTransform ScaleX="1.5" ScaleY="1.5"/></Path.RenderTransform>
                        </Path>
                        <TextBlock Text="Accounts" HorizontalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabAbout" Style="{StaticResource TabButton}" GroupName="tabs" Checked="Tab_Checked" Margin="2,0">
                    <StackPanel>
                        <Path Data="{StaticResource IconInfo}" Width="16" Height="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                              StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5" Margin="0,4,0,7">
                            <Path.RenderTransform><ScaleTransform ScaleX="1.5" ScaleY="1.5"/></Path.RenderTransform>
                        </Path>
                        <TextBlock Text="About" HorizontalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
            <Border Height="1" Background="{DynamicResource Separator}"/>
        </StackPanel>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
            <Grid Margin="20,20,20,24">
                <!-- General -->
                <StackPanel x:Name="GeneralPage">
                    <TextBlock Text="Tray icon" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="Style" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="StyleBox" AutomationProperties.Name="Style" DockPanel.Dock="Right" Style="{StaticResource WinCombo}" VerticalAlignment="Center" SelectionChanged="General_Changed"/>
                            </DockPanel>
                            <Border Style="{StaticResource RowSeparator}"/>
                            <DockPanel x:Name="IconsRow" Style="{StaticResource Row}">
                                <TextBlock Text="Icons" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="IconsBox" AutomationProperties.Name="Icons" DockPanel.Dock="Right" Style="{StaticResource WinCombo}" VerticalAlignment="Center" SelectionChanged="General_Changed"/>
                            </DockPanel>
                            <Border Style="{StaticResource RowSeparator}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="Preview" Style="{StaticResource RowLabel}"/>
                                <Border x:Name="PreviewChip" DockPanel.Dock="Right" VerticalAlignment="Center" Height="32" Padding="10,0" CornerRadius="4" BorderThickness="1"
                                        BorderBrush="{DynamicResource ControlBorder}">
                                    <ItemsControl x:Name="PreviewIcons" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Image Source="{Binding Image}" Width="{Binding Size}" Height="{Binding Size}" Margin="7,0" Stretch="Fill" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </DockPanel>
                            <Border Style="{StaticResource RowSeparator}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="5-hour session" Style="{StaticResource RowLabel}"/>
                                <CheckBox x:Name="SessionSwitch" AutomationProperties.Name="5-hour session" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Checked="General_Changed" Unchecked="General_Changed"/>
                            </DockPanel>
                            <Border Style="{StaticResource RowSeparator}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="Weekly" Style="{StaticResource RowLabel}"/>
                                <CheckBox x:Name="WeeklySwitch" AutomationProperties.Name="Weekly" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Checked="General_Changed" Unchecked="General_Changed"/>
                            </DockPanel>
                            <Border Style="{StaticResource RowSeparator}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="Model weekly (e.g. Fable)" Style="{StaticResource RowLabel}"/>
                                <CheckBox x:Name="ScopedSwitch" AutomationProperties.Name="Model weekly" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Checked="General_Changed" Unchecked="General_Changed"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Flyout" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Layout" Style="{StaticResource RowLabel}"/>
                            <ComboBox x:Name="LayoutBox" AutomationProperties.Name="Layout" DockPanel.Dock="Right" Style="{StaticResource WinCombo}" VerticalAlignment="Center" SelectionChanged="General_Changed"/>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="Refresh" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Refresh every" Style="{StaticResource RowLabel}"/>
                            <ComboBox x:Name="RefreshBox" AutomationProperties.Name="Refresh every" DockPanel.Dock="Right" Style="{StaticResource WinCombo}" VerticalAlignment="Center" SelectionChanged="General_Changed"/>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="General" Style="{StaticResource SectionTitle}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="Launch at login" Style="{StaticResource RowLabel}"/>
                                <CheckBox x:Name="LoginSwitch" AutomationProperties.Name="Launch at login" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Checked="Login_Changed" Unchecked="Login_Changed"/>
                            </DockPanel>
                            <Border Style="{StaticResource RowSeparator}"/>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="Currency" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="CurrencyBox" AutomationProperties.Name="Currency" DockPanel.Dock="Right" Style="{StaticResource WinCombo}" VerticalAlignment="Center" SelectionChanged="General_Changed"/>
                            </DockPanel>
                            <Border x:Name="RateSeparator" Style="{StaticResource RowSeparator}"/>
                            <DockPanel x:Name="RateRow" Style="{StaticResource Row}">
                                <TextBlock Text="Exchange rate" Style="{StaticResource RowLabel}"/>
                                <TextBlock x:Name="RateText" DockPanel.Dock="Right" FontSize="13" Foreground="{DynamicResource Secondary}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Accounts -->
                <StackPanel x:Name="AccountsPage" Visibility="Collapsed">
                    <ItemsControl x:Name="AccountsList" ItemTemplate="{StaticResource AccountCard}" Focusable="False"/>
                    <Border Style="{StaticResource Card}">
                        <DockPanel Style="{StaticResource Row}" MinHeight="52">
                            <Button x:Name="AddButton" DockPanel.Dock="Right" Style="{StaticResource WinButton}" VerticalAlignment="Center" Click="Add_Click" Padding="14,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Add Account" VerticalAlignment="Center"/>
                                    <Path Data="{StaticResource IconChevronDown}" Stroke="{DynamicResource Text}" StrokeThickness="1.3" Width="16" Height="16" Margin="10,0,0,0"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform><ScaleTransform ScaleX="0.75" ScaleY="0.75"/></Path.RenderTransform>
                                    </Path>
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="AddMenu">
                                        <MenuItem Header="Claude Code login" Click="AddClaudeCode_Click"/>
                                        <MenuItem Header="Claude app" Click="AddDesktop_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- About -->
                <StackPanel x:Name="AboutPage" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" Margin="0,12,0,24">
                        <Image x:Name="AppIconImage" Width="104" Height="104" Margin="0,0,0,16">
                            <Image.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="4" Opacity="0.45" Direction="270"/></Image.Effect>
                        </Image>
                        <TextBlock Text="Usage Bar" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="VersionText" FontSize="13" Foreground="{DynamicResource Secondary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <StackPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Text="Built" Style="{StaticResource RowLabel}"/>
                                <TextBlock x:Name="BuiltText" DockPanel.Dock="Right" FontSize="13" Foreground="{DynamicResource Secondary}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Style="{StaticResource RowSeparator}"/>
                            <DockPanel Style="{StaticResource Row}" Margin="16,12">
                                <TextBlock Text="Reads from" Style="{StaticResource RowLabel}" VerticalAlignment="Top"/>
                                <StackPanel DockPanel.Dock="Right" TextBlock.FontSize="13" TextBlock.Foreground="{DynamicResource Secondary}">
                                    <TextBlock Text="Anthropic API — usage and profile" Margin="0,0,0,4"/>
                                    <TextBlock Text="claude.ai — usage via your existing sign-in" Margin="0,0,0,4"/>
                                    <TextBlock Text="Claude Code logs on this PC — cost" Margin="0,0,0,4"/>
                                    <TextBlock Text="open.er-api.com — exchange rate (none for USD)"/>
                                </StackPanel>
                            </DockPanel>
                            <Border x:Name="FolderSeparator" Style="{StaticResource RowSeparator}"/>
                            <DockPanel x:Name="FolderRow" Style="{StaticResource Row}" MinHeight="52">
                                <TextBlock Text="Project folder" Style="{StaticResource RowLabel}"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="FolderText" FontSize="13" Foreground="{DynamicResource Secondary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Content="Show in Explorer" Style="{StaticResource WinButton}" Click="ShowFolder_Click"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock TextAlignment="Center" FontSize="11" LineHeight="17" Foreground="{DynamicResource Secondary}" TextWrapping="Wrap" Margin="-8,0">
                        Usage Bar is independent. It reads your existing sign-ins, and all usage data comes from Anthropic.<LineBreak/>Built by AI (Claude, by Anthropic) under the direction of its author, Sipheren (<Hyperlink NavigateUri="mailto:sipheren@gmail.com" RequestNavigate="Link_Navigate" Foreground="{DynamicResource Accent}">sipheren@gmail.com</Hyperlink>).<LineBreak/>MIT License.
                    </TextBlock>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
