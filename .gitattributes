# Shell scripts and git hooks must keep LF endings, or Git Bash on Windows fails with $'\r' errors.
*.sh text eol=lf
.githooks/* text eol=lf
config/local.env.example text eol=lf

# Windows batch files keep CRLF endings, as cmd.exe expects.
*.cmd text eol=crlf

# Binary assets: never touch their bytes (Windows checkouts use core.autocrlf).
*.png binary
*.ico binary
