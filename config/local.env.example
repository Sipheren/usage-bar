# Machine-specific settings for scripts/build.sh and scripts/check-secrets.sh.
# Copy to config/local.env (not tracked) and edit. Values are plain shell assignments.

# Code-signing identity for the app (see: security find-identity -v -p codesigning).
# A stable identity keeps macOS permission grants (Keychain "Always Allow", Full Disk Access,
# Login Items) across rebuilds. Leave empty to sign ad-hoc (grants reset on every build).
USAGEBAR_SIGN_IDENTITY=""

# Extra words or patterns (extended regex, | separated) that check-secrets.sh must never find in
# tracked files, such as your name, employer, hostname or account id prefixes. Kept here, untracked,
# so the list itself never ends up in the repository.
SECRET_SCAN_PRIVATE_PATTERNS=""
