# Machine-local settings for this repository's scripts, on any platform.
# scripts/setup-dev.sh copies this to config/local.env (not tracked); edit that copy.
# Values are plain shell assignments (Git Bash reads them on Windows).

# macOS: code-signing identity for macos/scripts/build.sh (see: security find-identity -v -p codesigning).
# A stable identity keeps macOS permission grants (Keychain "Always Allow", Full Disk Access,
# Login Items) across rebuilds. Leave empty to sign ad-hoc (grants reset on every build).
USAGEBAR_SIGN_IDENTITY=""

# All platforms: extra words or patterns (extended regex, | separated) that scripts/check-secrets.sh
# and the pre-commit hook must never find in
# tracked files, such as your name, employer, hostname or account id prefixes. Kept here, untracked,
# so the list itself never ends up in the repository.
SECRET_SCAN_PRIVATE_PATTERNS=""
